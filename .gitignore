# ============================================================
# SMS Simulator - Git Ignore
# ============================================================

# ------------------------------------------------------------
# IDEs / Editors
# ------------------------------------------------------------

.idea/
.vscode/
*.iml
*.iws
*.ipr

# Eclipse / STS
.classpath
.project
.settings/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/.nb-gradle/

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Java / Maven
# ------------------------------------------------------------

**/target/
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/pom.xml.next
**/release.properties
**/dependency-reduced-pom.xml
**/.flattened-pom.xml

# Java compiled files
*.class

# Logs
*.log

# ------------------------------------------------------------
# Spring Boot
# ------------------------------------------------------------

application-local.yml
application-local.yaml
application-*.properties
!application.yml
!application.yaml

# ------------------------------------------------------------
# SQLite
# ------------------------------------------------------------

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local application data
/data/
/backend/data/
/backend/.data/

# SQLite backups
*.db.bak
*.sqlite.bak

# ------------------------------------------------------------
# Node / React / Vite
# ------------------------------------------------------------

node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite
**/.vite/
**/dist/

# Coverage
coverage/
.nyc_output/

# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.template

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

docker-compose.override.yml
docker-compose.local.yml

# Docker development data
docker-data/
docker-volumes/

# ------------------------------------------------------------
# Generated exports
# ------------------------------------------------------------

exports/
*.csv
*.json

# Keep example/sample files if required
!examples/
!samples/

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

*.tmp
*.temp
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------
# Build / generated archives
# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.jar

# Keep Maven wrapper JAR if you add Maven Wrapper later
!.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------
# Test output
# ------------------------------------------------------------

test-output/
surefire-reports/
failsafe-reports/

# ------------------------------------------------------------
# Local runtime files
# ------------------------------------------------------------

*.pid
*.pid.lock
logs/
tmp/
temp/